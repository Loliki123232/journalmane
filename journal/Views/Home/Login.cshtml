@model User
@{
    ViewData["Title"] = "Вход в систему";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
</head>
<body>
    <div class="login-container">
        <div class="login-header">
            <h1>Вход в систему</h1>
            <p>Введите ваши учетные данные</p>
        </div>

        <form id="loginForm" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label asp-for="login" for="login">Логин:</label>
                <input asp-for="login" type="text" id="login" name="login" required placeholder="Введите ваш логин" aria-required="true">
            </div>

            <div class="form-group">
                <label asp-for="password" for="password">Пароль:</label>
                <input asp-for="password" type="password" id="password" name="password" required placeholder="Введите ваш пароль" aria-required="true">
                <span asp-validation-for="password" class="text-danger"></span>
            </div>

            <div class="remember-group">
                <input asp-for="rememberMe" type="checkbox" id="remember" name="rememberMe">
                <label asp-for="rememberMe" for="remember">Запомнить меня</label>
            </div>

            <!-- Компактный выбор роли -->
            <div class="role-selection">
                <div class="role-buttons">
                    <button type="submit" formaction="@Url.Action("Student")" class="role-btn student-btn" data-role="student">
                        Студент
                    </button>
                    <button type="submit" formaction="@Url.Action("Teacher")" class="role-btn teacher-btn" data-role="teacher">
                        Преподаватель
                    </button>
                    <button type="submit" formaction="@Url.Action("Admin")" class="role-btn admin-btn" data-role="admin">
                        Администратор
                    </button>
                </div>
            </div>
        </form>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const loginForm = document.getElementById('loginForm');
            const roleButtons = document.querySelectorAll('.role-btn');

            // Обработка выбора роли
            roleButtons.forEach(button => {
                button.addEventListener('click', function(e) {
                    const username = document.getElementById('login').value;
                    const password = document.getElementById('password').value;
                    const role = this.getAttribute('data-role');

                    // Валидация
                    if (!username.trim() || !password.trim()) {
                        e.preventDefault();
                        showMessage('Пожалуйста, заполните все поля', 'error');
                        return;
                    }

                    showMessage(`Вход как ${getRoleName(role)}...`, 'success');
                });
            });

            // Функция для получения названия роли
            function getRoleName(role) {
                const roles = {
                    'student': 'студент',
                    'teacher': 'преподаватель',
                    'admin': 'администратор'
                };
                return roles[role] || 'пользователь';
            }

            // Функция показа сообщений
            function showMessage(message, type) {
                // Удаляем предыдущие сообщения
                const existingMessage = document.querySelector('.message');
                if (existingMessage) {
                    existingMessage.remove();
                }

                const messageEl = document.createElement('div');
                messageEl.className = `message message-${type}`;
                messageEl.textContent = message;
                messageEl.style.cssText = `
                    position: fixed;
                    top: 20px;
                    left: 50%;
                    transform: translateX(-50%);
                    padding: 12px 20px;
                    border-radius: 8px;
                    color: white;
                    font-weight: 600;
                    z-index: 1000;
                    animation: slideDown 0.3s ease;
                    max-width: 90%;
                    text-align: center;
                    background: ${type === 'error' ? '#E53E3E' : type === 'success' ? '#38A169' : '#3182CE'};
                `;

                document.body.appendChild(messageEl);

                // Автоматическое скрытие
                setTimeout(() => {
                    if (messageEl.parentNode) {
                        messageEl.style.animation = 'slideUp 0.3s ease';
                        setTimeout(() => messageEl.remove(), 300);
                    }
                }, 3000);
            }

            // Добавляем стили для анимации сообщений
            const style = document.createElement('style');
            style.textContent = `
                @@keyframes slideDown {
                    from { transform: translateX(-50%) translateY(-100%); opacity: 0; }
                    to { transform: translateX(-50%) translateY(0); opacity: 1; }
                }
                @@keyframes slideUp {
                    from { transform: translateX(-50%) translateY(0); opacity: 1; }
                    to { transform: translateX(-50%) translateY(-100%); opacity: 0; }
                }
            `;
            document.head.appendChild(style);
        });
    </script>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary-blue: #3182CE;
            --dark-blue: #2B6CB0;
            --bright-blue: #4299E1;
            --accent-blue: #3182CE;
            --accent-dark: #2B6CB0;
            --admin-purple: #6B46C1;
            --admin-dark: #553C9A;
            --white: #ffffff;
            --gray-light: #F7FAFC;
            --gray-medium: #718096;
            --gray-dark: #2D3748;
            --border-gray: #E2E8F0;
            --shadow: 0 10px 30px rgba(49, 130, 206, 0.2);
            --shadow-hover: 0 5px 15px rgba(49, 130, 206, 0.3);
            --shadow-admin: 0 5px 15px rgba(107, 70, 193, 0.3);
            --border-radius: 12px;
            --transition: all 0.3s ease;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, var(--primary-blue) 0%, var(--dark-blue) 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
            line-height: 1.6;
        }

        .login-container {
            background: var(--white);
            padding: clamp(25px, 5vw, 40px);
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
            width: 100%;
            max-width: min(400px, 90vw);
            transition: var(--transition);
            border: 1px solid var(--border-gray);
        }

        .login-header {
            text-align: center;
            margin-bottom: clamp(20px, 4vw, 30px);
        }

            .login-header h1 {
                color: var(--primary-blue);
                font-size: clamp(24px, 5vw, 28px);
                margin-bottom: clamp(8px, 2vw, 10px);
                font-weight: 700;
                line-height: 1.2;
            }

            .login-header p {
                color: var(--gray-medium);
                font-size: clamp(13px, 3vw, 14px);
                line-height: 1.4;
            }

        .form-group {
            margin-bottom: clamp(15px, 3vw, 20px);
        }

            .form-group label {
                display: block;
                margin-bottom: clamp(4px, 1vw, 5px);
                color: var(--gray-dark);
                font-weight: 600;
                font-size: clamp(14px, 3vw, 16px);
            }

            .form-group input[type="text"],
            .form-group input[type="password"] {
                width: 100%;
                padding: clamp(10px, 2.5vw, 12px) clamp(12px, 3vw, 15px);
                border: 2px solid var(--border-gray);
                border-radius: 8px;
                font-size: clamp(14px, 3vw, 16px);
                transition: var(--transition);
                background: var(--white);
                color: var(--gray-dark);
            }

                .form-group input[type="text"]:focus,
                .form-group input[type="password"]:focus {
                    outline: none;
                    border-color: var(--bright-blue);
                    box-shadow: 0 0 0 3px rgba(66, 153, 225, 0.2);
                    transform: translateY(-1px);
                }

        .remember-group {
            display: flex;
            align-items: center;
            margin-bottom: clamp(20px, 4vw, 25px);
            padding: 5px 0;
        }

            .remember-group input[type="checkbox"] {
                margin-right: 10px;
                width: clamp(16px, 4vw, 18px);
                height: clamp(16px, 4vw, 18px);
                accent-color: var(--bright-blue);
                flex-shrink: 0;
            }

            .remember-group label {
                color: var(--gray-medium);
                cursor: pointer;
                font-size: clamp(14px, 3vw, 16px);
                user-select: none;
            }

        /* Компактный выбор роли */
        .role-selection {
            margin-top: 25px;
            padding-top: 20px;
            border-top: 1px solid var(--border-gray);
        }

        .role-buttons {
            display: flex;
            gap: 8px;
            justify-content: center;
        }

        .role-btn {
            flex: 1;
            padding: 8px 12px;
            border: 1px solid var(--border-gray);
            border-radius: 6px;
            font-size: 12px;
            font-weight: 500;
            cursor: pointer;
            transition: var(--transition);
            text-align: center;
            background: var(--white);
            color: var(--gray-dark);
            min-height: 36px;
        }

        .student-btn {
            color: var(--primary-blue);
            border-color: var(--primary-blue);
        }

            .student-btn:hover {
                background: var(--primary-blue);
                color: var(--white);
                transform: translateY(-1px);
                box-shadow: var(--shadow-hover);
            }

        .teacher-btn {
            color: var(--bright-blue);
            border-color: var(--bright-blue);
        }

            .teacher-btn:hover {
                background: var(--bright-blue);
                color: var(--white);
                transform: translateY(-1px);
                box-shadow: var(--shadow-hover);
            }

        .admin-btn {
            color: var(--admin-purple);
            border-color: var(--admin-purple);
        }

            .admin-btn:hover {
                background: var(--admin-purple);
                color: var(--white);
                transform: translateY(-1px);
                box-shadow: var(--shadow-admin);
            }

        /* Анимации */
        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .login-container {
            animation: fadeIn 0.6s ease-out;
        }

        /* Очень маленькие экраны (мобильные) */
        @@media (max-width: 360px) {
            body {
                padding: 10px;
            }

            .login-container {
                padding: 20px 15px;
                border-radius: 10px;
            }

            .role-buttons {
                gap: 6px;
            }

            .role-btn {
                font-size: 11px;
                padding: 6px 8px;
            }
        }

        /* Планшеты и маленькие ноутбуки */
        @@media (min-width: 768px) and (max-width: 1024px) {
            .login-container {
                max-width: 450px;
                padding: 35px;
            }

            .login-header h1 {
                font-size: 32px;
            }
        }

        /* Большие экраны */
        @@media (min-width: 1200px) {
            .login-container {
                max-width: 420px;
            }

                .login-container:hover {
                    transform: translateY(-5px);
                }
        }

        /* Поддержка темной темы */
        @@media (prefers-color-scheme: dark) {
            .login-container {
                background: #2d2d2d;
                border-color: #444;
            }

            .form-group label {
                color: #e0e0e0;
            }

            .form-group input[type="text"],
            .form-group input[type="password"] {
                background: #3d3d3d;
                border-color: #555;
                color: #fff;
            }

            .login-header h1 {
                color: var(--bright-blue);
            }

            .login-header p {
                color: #aaa;
            }

            .remember-group label {
                color: #aaa;
            }

            .role-selection {
                border-top-color: #555;
            }

            .role-btn {
                background: #3d3d3d;
                border-color: #555;
                color: #e0e0e0;
            }
        }

        /* Улучшения для доступности */
        @@media (prefers-reduced-motion: reduce) {
            * {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
            }
        }

        /* Фокус для клавиатурной навигации */
        .role-btn:focus-visible,
        input:focus-visible {
            outline: 2px solid var(--bright-blue);
            outline-offset: 2px;
        }
    </style>
</body>
</html>