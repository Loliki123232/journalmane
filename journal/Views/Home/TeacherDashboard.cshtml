@model TeacherDashboardViewModel
@{
    ViewData["Title"] = "Панель преподавателя";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary-blue: #2c3e50;
            --accent-blue: #3498db;
            --success: #27ae60;
            --warning: #f39c12;
            --danger: #e74c3c;
            --white: #ffffff;
            --gray-light: #ecf0f1;
            --shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            --border-radius: 8px;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, var(--primary-blue) 0%, #34495e 100%);
            min-height: 100vh;
            color: #333;
            padding: 20px;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
        }

        .header {
            background: var(--white);
            padding: 20px;
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
            margin-bottom: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logout-btn {
            background: var(--danger);
            color: var(--white);
            border: none;
            padding: 8px 16px;
            border-radius: var(--border-radius);
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
        }

        .dashboard-tabs {
            display: flex;
            margin-bottom: 20px;
            background: var(--white);
            border-radius: var(--border-radius);
            overflow: hidden;
        }

        .tab {
            padding: 15px 20px;
            background: var(--gray-light);
            border: none;
            cursor: pointer;
            font-weight: 600;
        }

            .tab.active {
                background: var(--accent-blue);
                color: var(--white);
            }

        .tab-content {
            display: none;
            background: var(--white);
            padding: 20px;
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
        }

            .tab-content.active {
                display: block;
            }

        .card {
            background: var(--white);
            padding: 20px;
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
            margin-bottom: 20px;
        }

            .card h3 {
                color: var(--primary-blue);
                margin-bottom: 15px;
                border-bottom: 2px solid var(--gray-light);
                padding-bottom: 10px;
            }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 15px;
            margin-bottom: 15px;
        }

        .form-group {
            margin-bottom: 15px;
        }

        .form-control {
            width: 100%;
            padding: 10px 12px;
            border: 2px solid #bdc3c7;
            border-radius: var(--border-radius);
        }

        .btn {
            padding: 10px 20px;
            border: none;
            border-radius: var(--border-radius);
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
            margin: 5px;
        }

        .btn-primary {
            background: var(--accent-blue);
            color: var(--white);
        }

        .btn-success {
            background: var(--success);
            color: var(--white);
        }

        .btn-danger {
            background: var(--danger);
            color: var(--white);
        }

        .table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }

            .table th, .table td {
                padding: 12px 15px;
                text-align: left;
                border-bottom: 1px solid var(--gray-light);
            }

            .table th {
                background: var(--primary-blue);
                color: var(--white);
                font-weight: 600;
            }

        .attendance-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 10px;
            margin-top: 15px;
        }

        .attendance-item {
            padding: 10px;
            border: 1px solid var(--gray-light);
            border-radius: var(--border-radius);
            text-align: center;
        }

        .present {
            background: #d4edda;
            color: #155724;
        }

        .absent {
            background: #f8d7da;
            color: #721c24;
        }

        .alert {
            padding: 12px;
            border-radius: var(--border-radius);
            margin-bottom: 15px;
        }

        .alert-success {
            background: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }

        .alert-danger {
            background: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }

        .grade-form {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .grade-input {
            width: 80px;
            padding: 5px;
            border: 2px solid #bdc3c7;
            border-radius: var(--border-radius);
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Панель преподавателя - @Model.Teacher.FullName</h1>
            <a href="/Home/Login" class="logout-btn">Выйти</a>
        </div>

        <!-- Отображение сообщений -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                @TempData["ErrorMessage"]
            </div>
        }

        <div class="dashboard-tabs">
            <button class="tab active" data-tab="assignments">📚 Задания</button>
            <button class="tab" data-tab="attendance">📅 Посещаемость</button>
            <button class="tab" data-tab="grades">📊 Оценки</button>
            <button class="tab" data-tab="submissions">📤 Работы студентов</button>
        </div>

        <!-- Вкладка заданий -->
        <div id="assignments" class="tab-content active">
            <div class="card">
                <h3>Создать новое задание</h3>
                <form method="post" formaction="@Url.Action("CreateAssignment", "Teacher")" enctype="multipart/form-data">
                    <div class="form-grid">
                        <div class="form-group">
                            <label>Название задания:</label>
                            <input type="text" name="Title" class="form-control" required>
                        </div>
                        <div class="form-group">
                            <label>Предмет:</label>
                            <input type="text" name="Subject" class="form-control" value="@Model.Teacher.Subject" required>
                        </div>
                        <div class="form-group">
                            <label>Группа:</label>
                            <select name="GroupId" class="form-control" required>
                                @foreach (var group in Model.Groups)
                                {
                                    <option value="@group.Id">@group.Name</option>
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Срок сдачи:</label>
                            <input type="date" name="DueDate" class="form-control" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Описание:</label>
                        <textarea name="Description" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="form-group">
                        <label>Файл задания (PDF/TXT/DOCX):</label>
                        <input type="file" name="AssignmentFile" class="form-control" accept=".pdf,.txt,.docx,.doc">
                    </div>
                    <button type="submit" formaction="@Url.Action("CreateAssignment", "Teacher")" class="btn btn-success">Создать задание</button>
                </form>
            </div>

            <div class="card">
                <h3>Мои задания</h3>
                @if (Model.Assignments.Any())
                {
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Название</th>
                                <th>Группа</th>
                                <th>Срок сдачи</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var assignment in Model.Assignments)
                            {
                                <tr>
                                    <td>@assignment.Title</td>
                                    <td>@assignment.GroupName</td>
                                    <td>@assignment.DueDate.ToString("dd.MM.yyyy")</td>
                                    <td>
                                        <a href="@Url.Action("AssignmentDetails", new { assignmentId = assignment.Id })" class="btn btn-primary">Просмотреть отправки</a>
                                        <form method="post" asp-action="DeleteAssignment" style="display: inline;">
                                            <input type="hidden" name="assignmentId" value="@assignment.Id" />
                                            <button type="submit" class="btn btn-danger" onclick="return confirm('Вы уверены, что хотите удалить это задание?')">Удалить</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p>У вас пока нет созданных заданий.</p>
                }
            </div>
        </div>

        <!-- Вкладка посещаемости -->
        <div id="attendance" class="tab-content">
            <div class="card">
                <h3>Отметить посещаемость</h3>
                <form method="post" asp-action="MarkAttendance" id="attendanceForm">
                    <div class="form-grid">
                        <div class="form-group">
                            <label>Группа:</label>
                            <select name="GroupId" class="form-control" id="attendanceGroup" required>
                                @foreach (var group in Model.Groups)
                                {
                                    <option value="@group.Id">@group.Name</option>
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Дата:</label>
                            <input type="date" name="Date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required>
                        </div>
                        <div class="form-group">
                            <label>Предмет:</label>
                            <select name="Subject" class="form-control" required>
                                <option value="@Model.Teacher.Subject">@Model.Teacher.Subject</option>
                            </select>
                        </div>
                    </div>

                    <div id="studentsAttendance">
                        <!-- Студенты будут загружены через JavaScript -->
                        <p>Выберите группу для загрузки студентов...</p>
                    </div>

                    <button type="submit" class="btn btn-success">Сохранить посещаемость</button>
                </form>
            </div>
        </div>

        <!-- Вкладка оценок -->
        <div id="grades" class="tab-content">
            <div class="card">
                <h3>Выставить оценку</h3>
                <form method="post" asp-action="AddGrade">
                    <div class="form-grid">
                        <div class="form-group">
                            <label>Студент:</label>
                            <select name="StudentId" class="form-control" required>
                                @foreach (var student in Model.Students)
                                {
                                    <option value="@student.Id">@student.FullName - @student.GroupName</option>
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Предмет:</label>
                            <input type="text" name="Subject" class="form-control" value="@Model.Teacher.Subject" required>
                        </div>
                        <div class="form-group">
                            <label>Оценка:</label>
                            <input type="number" name="GradeValue" class="form-control" min="1" max="100" required>
                        </div>
                        <div class="form-group">
                            <label>Тип оценки:</label>
                            <select name="GradeType" class="form-control" required>
                                <option value="homework">Домашняя работа</option>
                                <option value="test">Тест</option>
                                <option value="exam">Экзамен</option>
                                <option value="quiz">Контрольная работа</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Комментарий:</label>
                        <textarea name="Comments" class="form-control" rows="2"></textarea>
                    </div>
                    <button type="submit" class="btn btn-success">Выставить оценку</button>
                </form>
            </div>
        </div>

        <!-- Вкладка работ студентов -->
        <div id="submissions" class="tab-content">
            <div class="card">
                <h3>Работы студентов на проверку</h3>
                @if (Model.Submissions.Any())
                {
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Студент</th>
                                <th>Задание</th>
                                <th>Дата отправки</th>
                                <th>Файл</th>
                                <th>Оценка</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var submission in Model.Submissions)
                            {
                                <tr>
                                    <td>@submission.StudentName</td>
                                    <td>@submission.AssignmentTitle</td>
                                    <td>@submission.SubmittedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>
                                        <a href="@Url.Action("DownloadSubmission", new { submissionId = submission.Id })" class="btn btn-primary">Скачать</a>
                                    </td>
                                    <td>
                                        @if (submission.Grade.HasValue)
                                        {
                                            <span>@submission.Grade</span>
                                        }
                                        else
                                        {
                                            <span style="color: var(--warning);">Не оценено</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!submission.Grade.HasValue)
                                        {
                                            <form method="post" asp-action="GradeSubmission" class="grade-form">
                                                <input type="hidden" name="SubmissionId" value="@submission.Id" />
                                                <input type="number" name="Grade" min="1" max="100" placeholder="Оценка" class="grade-input" required>
                                                <textarea name="Feedback" placeholder="Комментарий" rows="1" style="flex: 1;"></textarea>
                                                <button type="submit" class="btn btn-success">Оценить</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span style="color: var(--success);">Проверено</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p>Нет работ студентов на проверку.</p>
                }
            </div>
        </div>
    </div>

    <script>
        // Навигация по вкладкам
        document.querySelectorAll('.tab').forEach(tab => {
            tab.addEventListener('click', function() {
                document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
                document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));

                this.classList.add('active');
                const tabId = this.getAttribute('data-tab');
                document.getElementById(tabId).classList.add('active');
            });
        });

        // Загрузка студентов для посещаемости
        document.getElementById('attendanceGroup').addEventListener('change', function() {
            const groupId = this.value;
            loadStudentsForAttendance(groupId);
        });

        // Загрузка студентов при изменении даты
        document.querySelector('input[name="Date"]').addEventListener('change', function() {
            const groupId = document.getElementById('attendanceGroup').value;
            const date = this.value;
            const subject = document.querySelector('select[name="Subject"]').value;
            loadAttendanceForDate(groupId, date, subject);
        });

        async function loadStudentsForAttendance(groupId) {
            const container = document.getElementById('studentsAttendance');
            container.innerHTML = '<p>Загрузка студентов...</p>';

            try {
                const response = await fetch(`/Teacher/GetStudentsByGroup?groupId=${groupId}`);
                const students = await response.json();

                if (students.error) {
                    container.innerHTML = `<p style="color: red;">Ошибка: ${students.error}</p>`;
                    return;
                }

                let html = '<div class="attendance-grid">';
                students.forEach(student => {
                    html += `
                        <div class="attendance-item">
                            <label>
                                <input type="checkbox" name="AttendanceStatus" value="true" checked>
                                <input type="hidden" name="StudentIds" value="${student.id}">
                                ${student.name}
                            </label>
                        </div>
                    `;
                });
                html += '</div>';
                container.innerHTML = html;
            } catch (error) {
                container.innerHTML = `<p style="color: red;">Ошибка загрузки: ${error.message}</p>`;
            }
        }

        async function loadAttendanceForDate(groupId, date, subject) {
            const container = document.getElementById('studentsAttendance');

            try {
                const response = await fetch(`/Teacher/GetAttendanceForDate?groupId=${groupId}&date=${date}&subject=${subject}`);
                const attendanceData = await response.json();

                if (attendanceData.error) {
                    console.error('Ошибка:', attendanceData.error);
                    return;
                }

                let html = '<div class="attendance-grid">';
                attendanceData.forEach(item => {
                    const isPresent = item.isPresent ? 'checked' : '';
                    html += `
                        <div class="attendance-item ${item.isPresent ? 'present' : 'absent'}">
                            <label>
                                <input type="checkbox" name="AttendanceStatus" value="true" ${isPresent}>
                                <input type="hidden" name="StudentIds" value="${item.studentId}">
                                ${item.studentName}
                            </label>
                        </div>
                    `;
                });
                html += '</div>';
                container.innerHTML = html;
            } catch (error) {
                console.error('Ошибка загрузки посещаемости:', error);
            }
        }

        // Загрузка начальных данных
        document.addEventListener('DOMContentLoaded', function() {
            const groupId = document.getElementById('attendanceGroup').value;
            const date = document.querySelector('input[name="Date"]').value;
            const subject = document.querySelector('select[name="Subject"]').value;

            loadAttendanceForDate(groupId, date, subject);
        });
    </script>
</body>
</html>