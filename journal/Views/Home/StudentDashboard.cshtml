@model StudentDashboardViewModel
@{
    ViewData["Title"] = "Панель студента";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary-blue: #2c3e50;
            --accent-blue: #3498db;
            --success: #27ae60;
            --warning: #f39c12;
            --danger: #e74c3c;
            --white: #ffffff;
            --gray-light: #ecf0f1;
            --shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            --border-radius: 8px;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, var(--primary-blue) 0%, #34495e 100%);
            min-height: 100vh;
            color: #333;
            padding: 20px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .header {
            background: var(--white);
            padding: 20px;
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
            margin-bottom: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logout-btn {
            background: var(--danger);
            color: var(--white);
            border: none;
            padding: 8px 16px;
            border-radius: var(--border-radius);
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
        }

        .dashboard-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .card {
            background: var(--white);
            padding: 20px;
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
        }

            .card h3 {
                color: var(--primary-blue);
                margin-bottom: 15px;
                border-bottom: 2px solid var(--gray-light);
                padding-bottom: 10px;
            }

        .assignment-item, .grade-item {
            padding: 10px;
            border: 1px solid var(--gray-light);
            border-radius: var(--border-radius);
            margin-bottom: 10px;
        }

        .assignment-due {
            color: var(--danger);
            font-weight: bold;
        }

        .btn {
            padding: 8px 16px;
            border: none;
            border-radius: var(--border-radius);
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
            margin: 5px;
        }

        .btn-primary {
            background: var(--accent-blue);
            color: var(--white);
        }

        .file-input {
            margin: 10px 0;
        }

        .grade-excellent {
            color: var(--success);
            font-weight: bold;
        }

        .grade-good {
            color: var(--accent-blue);
            font-weight: bold;
        }

        .grade-satisfactory {
            color: var(--warning);
            font-weight: bold;
        }

        .grade-poor {
            color: var(--danger);
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Панель студента - @Model.Student.FullName</h1>
            <a href="/Home/Login" class="logout-btn">Выйти</a>
        </div>

        <div class="dashboard-grid">
            <!-- Задания -->
            <div class="card">
                <h3>📚 Домашние задания</h3>
                @foreach (var assignment in Model.Assignments)
                {
                    <div class="assignment-item">
                        <h4>@assignment.Title</h4>
                        <p>@assignment.Description</p>
                        <p><strong>Предмет:</strong> @assignment.Subject</p>
                        <p><strong>Срок сдачи:</strong> <span class="assignment-due">@assignment.DueDate.ToString("dd.MM.yyyy")</span></p>

                        @if (!string.IsNullOrEmpty(assignment.FilePath))
                        {
                            <a href="@assignment.FilePath" class="btn btn-primary" download>📥 Скачать задание</a>
                        }

                        <!-- Форма для отправки решения -->
                        <form method="post" action="/Student/SubmitAssignment" enctype="multipart/form-data">
                            <input type="hidden" name="assignmentId" value="@assignment.Id" />
                            <div class="file-input">
                                <input type="file" name="solutionFile" accept=".pdf,.txt" required />
                            </div>
                            <button type="submit" class="btn btn-primary">📤 Отправить решение</button>
                        </form>
                    </div>
                }
            </div>

            <!-- Оценки -->
            <div class="card">
                <h3>📊 Мои оценки</h3>
                @foreach (var grade in Model.Grades)
                {
                    <div class="grade-item">
                        <p>
                            <strong>@grade.Subject</strong> -
                            <span class="@GetGradeClass(grade.GradeValue)">@grade.GradeValue</span>
                            (@grade.GradeType)
                        </p>
                        <p><small>@grade.Date.ToString("dd.MM.yyyy")</small></p>
                        @if (!string.IsNullOrEmpty(grade.Comments))
                        {
                            <p><em>@grade.Comments</em></p>
                        }
                    </div>
                }
            </div>

            <!-- Отправленные работы -->
            <div class="card">
                <h3>📤 Отправленные работы</h3>
                @foreach (var submission in Model.Submissions)
                {
                    <div class="assignment-item">
                        <p><strong>@submission.AssignmentTitle</strong></p>
                        <p>Отправлено: @submission.SubmittedAt.ToString("dd.MM.yyyy HH:mm")</p>
                        @if (submission.Grade.HasValue)
                        {
                            <p>Оценка: <span class="@GetGradeClass(submission.Grade.Value)">@submission.Grade</span></p>
                            @if (!string.IsNullOrEmpty(submission.Feedback))
                            {
                                <p>Комментарий: @submission.Feedback</p>
                            }
                        }
                        else
                        {
                            <p>Оценка: <em>ожидает проверки</em></p>
                        }
                    </div>
                }
            </div>

            <!-- Посещаемость -->
            <div class="card">
                <h3>📅 Посещаемость</h3>
                @foreach (var attendance in Model.Attendance)
                {
                    <div class="assignment-item">
                        <p><strong>@attendance.Subject</strong> - @attendance.Date.ToString("dd.MM.yyyy")</p>
                        <p>
                            Статус:
                            @if (attendance.IsPresent)
                            {
                                <span style="color: var(--success);">✅ Присутствовал</span>
                            }
                            else
                            {
                                <span style="color: var(--danger);">❌ Отсутствовал</span>
                            }
                        </p>
                    </div>
                }
            </div>
        </div>
    </div>
</body>
</html>

@functions {
    string GetGradeClass(int grade)
    {
        if (grade >= 90) return "grade-excellent";
        if (grade >= 75) return "grade-good";
        if (grade >= 60) return "grade-satisfactory";
        return "grade-poor";
    }
}